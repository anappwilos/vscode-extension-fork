{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Fork Extension (VS Code)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Runtime Start",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/start.js",
      "preLaunchTask": "npm: build",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
