{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Fork Extension (VS Code)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Antigravity Playground",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/playground/index.js",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Run VS Code + Antigravity",
      "configurations": [
        "Run Fork Extension (VS Code)",
        "Run Antigravity Playground"
      ]
    }
  ]
}
