{
  "publisher": "imyangyong",
  "name": "fork",
  "displayName": "Fork",
  "version": "0.3.1",
  "packageManager": "npm@11.4.2",
  "description": "Open the current workspace repository in the Fork desktop app.",
  "repository": {
    "type": "git",
    "url": "https://github.com/imyangyong/vscode-extension-fork"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "res/icon.webp",
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onCommand:fork.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fork.open",
        "title": "Fork: open current git repository in Fork"
      }
    ],
    "configuration": {
      "title": "Fork",
      "properties": {
        "fork.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the Fork executable. If empty on macOS, the extension uses `open -a Fork`. On Windows/Linux this setting is required.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist .test-dist",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/index.js --sourcemap --watch",
    "prebuild": "npm run lint && npm run typecheck && npm run test",
    "build": "npm run clean && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/index.js --sourcemap",
    "start": "node -e \"console.log('Use VS Code Extension Host (F5) to run the extension.')\"",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/tests/**/*.test.js",
    "test:watch": "npm run test:compile && node --test --watch .test-dist/tests/**/*.test.js",
    "vscode:prepublish": "npm run build",
    "publish": "vsce publish --no-dependencies",
    "pack": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.12",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "overrides": {
    "glob": "^10.4.5"
  }
}
