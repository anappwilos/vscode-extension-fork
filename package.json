{
  "publisher": "imyangyong",
  "name": "fork",
  "displayName": "Fork",
  "version": "0.2.3",
  "packageManager": "npm@11.4.2",
  "description": "Open the current workspace repository in the Fork desktop app.",
  "repository": {
    "type": "git",
    "url": "https://github.com/imyangyong/vscode-extension-fork"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "res/icon.webp",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onCommand:fork.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fork.open",
        "title": "Fork: open current git repository in Fork"
      }
    ],
    "configuration": {
      "title": "Fork",
      "properties": {
        "fork.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the Fork executable. If empty on macOS, the extension uses `open -a Fork`. On Windows/Linux this setting is required.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "NODE_ENV=production tsup",
    "dev": "NODE_ENV=development tsup --watch",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint --fix src --ext ts",
    "publish": "vsce publish --no-dependencies",
    "pack": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.0",
    "@types/node": "^22.15.12",
    "@types/vscode": "^1.99.0",
    "eslint": "^9.26.0",
    "pnpm": "^10.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vsce": "^2.10.0"
  }
}
